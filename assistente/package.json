{
  "name": "lumi-assistente",
  "version": "1.0.0",
  "description": "Lumi: assistente virtual que mora no topo da tela",
  "main": "desktop/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "dist:win": "electron-builder --win nsis portable",
    "dist:mac": "electron-builder --mac dmg",
    "unico": "node scripts/arquivo-unico.js",
    "voz": "node scripts/baixar-voz.js"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "br.com.lumi.assistente",
    "productName": "Lumi",
    "files": [
      "index.html",
      "icone.svg",
      "css/**",
      "js/**",
      "desktop/**",
      "node_modules/**",
      "!node_modules/onnxruntime-web/**",
      "!node_modules/.cache/**",
      "!node_modules/electron/**",
      "!node_modules/electron-builder/**"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png",
      "files": [
        "!node_modules/onnxruntime-node/bin/napi-v*/linux/**",
        "!node_modules/onnxruntime-node/bin/napi-v*/darwin/**",
        "!node_modules/onnxruntime-node/bin/napi-v*/win32/arm64/**"
      ]
    },
    "mac": {
      "category": "public.app-category.productivity"
    },
    "nsis": {
      "artifactName": "Lumi-Instalador.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Lumi"
    },
    "portable": {
      "artifactName": "Lumi-Portatil.${ext}"
    },
    "extraResources": [
      {
        "from": "voz/modelo-pt.tar.gz",
        "to": "voz/modelo-pt.tar.gz"
      }
    ],
    "asarUnpack": [
      "node_modules/onnxruntime-node/**",
      "node_modules/sharp/**",
      "node_modules/@img/**"
    ]
  },
  "author": "Lumi",
  "dependencies": {
    "@huggingface/transformers": "3.8.1",
    "vosk-browser": "^0.0.8"
  }
}
